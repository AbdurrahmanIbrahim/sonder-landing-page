    { "source": "/signup", "destination": "https://app.yousonder.com/signup", "permanent": true },
    { "source": "/forgot-password", "destination": "https://app.yousonder.com/forgot-password", "permanent": true },
    { "source": "/reset-password", "destination": "https://app.yousonder.com/reset-password", "permanent": true },
    { "source": "/pricing", "destination": "/#pricing", "permanent": false },
    { "source": "/unsubscribe", "destination": "https://app.yousonder.com/unsubscribe", "permanent": true },
    { "source": "/privacy", "destination": "https://app.yousonder.com/privacy", "permanent": false },
